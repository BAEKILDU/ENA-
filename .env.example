# ENA 가치+ — Streamlit 환경 변수 예시
# 이 파일을 복사해 `.env` 로 저장하거나, Streamlit Cloud Secrets에 동일 키를 등록하세요.

OPENAI_API_KEY=

# Supabase Dashboard → Project Settings → API
# Project URL 예: https://xxxxxxxx.supabase.co
# 호스트가 존재하지 않으면 앱이 로컬 SQLite로 자동 전환합니다 (SQL Editor 수동 실행 불필요).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
